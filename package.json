{
  "name": "olos-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "examples/*",
    "benchmarks",
    "olos"
  ],
  "scripts": {
    "audit": "bun audit",
    "build": "bun --filter '@arsenstorm/olos' build",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun install",
    "check": "ultracite check",
    "check-types": "bun --filter '@arsenstorm/olos' build && bun --filter '!olos-root' check-types",
    "fix": "ultracite fix",
    "prepare": "husky",
    "publish:check": "bun --filter '@arsenstorm/olos' publish:check",
    "test": "bun --filter '@arsenstorm/olos' test",
    "test:e2e": "bun --filter '@arsenstorm/olos' test:e2e",
    "test:live-s3": "bun --filter '@arsenstorm/olos' test:live-s3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "typescript": "^7",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.3.14"
}
