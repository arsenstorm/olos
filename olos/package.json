{
  "name": "@arsenstorm/olos",
  "version": "0.6.0",
  "description": "Open Live Object Streaming protocol primitives.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsenstorm/olos.git",
    "directory": "olos"
  },
  "bugs": {
    "url": "https://github.com/arsenstorm/olos/issues"
  },
  "homepage": "https://github.com/arsenstorm/olos#readme",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "default": "./dist/media.js"
    },
    "./hls": {
      "types": "./dist/hls.d.ts",
      "import": "./dist/hls.js",
      "default": "./dist/hls.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js",
      "default": "./dist/s3.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/clean-dist.ts && tsc --project tsconfig.build.json && bun scripts/fix-declaration-imports.ts",
    "check-types": "tsc --project tsconfig.json --noEmit",
    "check-types:dist": "tsc --project tsconfig.e2e.json --noEmit",
    "conformance:check": "bun scripts/check-conformance.ts && bun scripts/check-spec-refs.ts",
    "conformance:report": "bun scripts/write-conformance-report.ts",
    "pack:artifact": "bun scripts/require-dist.ts && bun scripts/create-package-artifact.ts",
    "pack:check": "publint --strict && bun scripts/attw-check.ts",
    "pack:smoke": "bun scripts/require-dist.ts && bun scripts/package-smoke.ts",
    "publish:check": "bun run conformance:check && bun run check-types && bun run test && bun run build && bun run check-types:dist && bun run test:e2e && bun run pack:check && bun run pack:smoke",
    "release:verify-published": "bun scripts/verify-published-package.ts",
    "report:file-sizes": "bun scripts/report-file-sizes.ts",
    "spec:generate": "bun scripts/write-spec-schemas.ts && bun scripts/write-conformance-report.ts",
    "test": "bun test src scripts --pass-with-no-tests --path-ignore-patterns 'e2e/**' --path-ignore-patterns '**/*.e2e.test.ts'",
    "test:e2e": "bun scripts/require-dist.ts && vitest run --config vitest.e2e.config.ts",
    "test:live-s3": "vitest run --config vitest.live-s3.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "publint": "^0.3.22",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  }
}
